
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Explore Chandigarh | The City Beautiful</title>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --green: #155e52;
    --dark: #103d35;
    --gold: #d9a441;
    --cream: #f8f8f3;
    --text: #202c28;
    --muted: #69756f;
    --border: #e5e9e3;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: "DM Sans", sans-serif;
    background: var(--cream);
    color: var(--text);
    line-height: 1.65;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    display: block;
    width: 100%;
    object-fit: cover;
}

.container {
    width: min(1160px, 90%);
    margin: auto;
}

h1, h2, h3 {
    font-family: "Playfair Display", serif;
    line-height: 1.2;
}

section {
    padding: 80px 0;
}

.eyebrow {
    display: inline-block;
    color: var(--green);
    font-size: .78rem;
    letter-spacing: 2px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.section-heading {
    max-width: 700px;
    margin-bottom: 32px;
}

.section-heading h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 14px;
}

.section-heading p {
    color: var(--muted);
}

/* ================= TRANSPARENT HEADER ================= */

header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: transparent;
    border: none;
}

.navbar {
    min-height: 100px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: nowrap;
    position: relative;
}

/* LOGO IMAGE + NAME IN ONE LINE */

.logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: white;
    font-weight: 700;
    font-size: 1.08rem;
    white-space: nowrap;
    flex: 0 0 auto;
}

.logo-image {
    width: 120px;
    height: 120px;
    object-fit: contain;
    border-radius: 50%;
    border: 2px solid #ffffff80;
    flex-shrink: 0;
}

/* DESKTOP NAVIGATION IN ONE LINE */

.nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(10px, 1.4vw, 20px);
    white-space: nowrap;
    flex-wrap: nowrap;
    margin: 0;
    padding: 0;
}

.nav-links a {
    display: inline-block;
    color: white;
    font-size: .84rem;
    font-weight: 600;
    transition: color .2s;
    text-shadow: 0 1px 5px #00000040;
}

.nav-links a:hover {
    color: var(--gold);
}

.nav-cta {
    background: var(--gold);
    color: #202b23 !important;
    padding: 10px 13px;
    border-radius: 8px;
    text-shadow: none !important;
}

.nav-cta:hover {
    background: #edc16a;
}

.menu-toggle {
    display: none;
    font-size: 1.8rem;
    color: white;
    background: transparent;
    border: 0;
    cursor: pointer;
    flex-shrink: 0;
}

/* ================= HERO ================= */

.hero {
    min-height: 680px;
    display: flex;
    align-items: center;
    color: white;
    background-color: #244c40;
    background-image:
        linear-gradient(
            90deg,
            rgba(7,35,30,.86),
            rgba(7,35,30,.28)
        ),
        url("https://commons.wikimedia.org/wiki/Special:FilePath/Sukhna_Lake_Chandigarh_India.jpg");
    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 760px;
    padding: 140px 0 90px;
}

.hero .eyebrow {
    color: #f3d28e;
}

.hero h1 {
    font-size: clamp(3rem, 7vw, 5.3rem);
    letter-spacing: -1.5px;
    margin-bottom: 22px;
}

.hero p {
    max-width: 620px;
    color: #edf4ef;
    font-size: 1.05rem;
    margin-bottom: 30px;
}

.button {
    display: inline-block;
    padding: 13px 21px;
    border-radius: 8px;
    font-weight: 700;
    transition: .2s;
}

.button:hover {
    transform: translateY(-2px);
}

.button-gold {
    background: var(--gold);
    color: #202b23;
}

.button-outline {
    border: 1px solid white;
    color: white;
    margin-left: 9px;
}

/* ================= HIGHLIGHTS ================= */

.facts {
    background: white;
    border-bottom: 1px solid var(--border);
}

.facts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 24px 0;
}

.fact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    padding: 8px 15px;
    border-right: 1px solid var(--border);
}

.fact:last-child {
    border-right: 0;
}

.fact-icon {
    font-size: 1.7rem;
}

.fact strong {
    display: block;
    color: var(--green);
}

.fact small {
    color: var(--muted);
}

/* ================= DESTINATIONS ================= */

#destinations {
    background: var(--cream);
}

.tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
}

.search {
    flex: 1;
    min-width: 230px;
    max-width: 420px;
}

.search input {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid var(--border);
    border-radius: 9px;
    outline: none;
    background: white;
    font: inherit;
}

.search input:focus {
    border-color: var(--green);
}

.filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.filter-btn {
    padding: 9px 14px;
    border: 1px solid var(--border);
    background: white;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    color: #45534c;
}

.filter-btn.active,
.filter-btn:hover {
    background: var(--green);
    color: white;
    border-color: var(--green);
}

.places-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.place-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: .25s;
}

.place-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 30px #19372b17;
}

.place-image {
    height: 235px;
    position: relative;
    background: #dce6df;
    overflow: hidden;
}

.place-image img {
    height: 100%;
    transition: transform .4s;
}

.place-card:hover .place-image img {
    transform: scale(1.04);
}

.tag {
    position: absolute;
    left: 13px;
    top: 13px;
    background: white;
    color: var(--green);
    padding: 6px 10px;
    border-radius: 6px;
    font-size: .75rem;
    font-weight: 700;
}

.place-content {
    padding: 22px;
}

.place-content h3 {
    font-size: 1.4rem;
    margin-bottom: 10px;
}

.place-content p {
    color: var(--muted);
    font-size: .92rem;
    min-height: 76px;
}

.place-footer {
    border-top: 1px solid var(--border);
    margin-top: 16px;
    padding-top: 14px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: .83rem;
}

.place-footer span {
    color: var(--muted);
}

.place-footer a {
    color: var(--green);
    font-weight: 700;
    white-space: nowrap;
}

.no-results {
    grid-column: 1 / -1;
    text-align: center;
    padding: 35px;
    background: white;
    border-radius: 10px;
}

/* ================= ABOUT ================= */

.about {
    background: #edf2ec;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 55px;
    align-items: center;
}

.about-photo {
    position: relative;
}

.about-photo img {
    height: 430px;
    border-radius: 15px;
    box-shadow: 0 12px 30px #19372b17;
}

.photo-caption {
    position: absolute;
    bottom: 18px;
    left: 18px;
    padding: 12px 16px;
    background: white;
    color: var(--green);
    border-radius: 8px;
    font-weight: 700;
}

.about-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 18px;
}

.about-copy p {
    color: #59665e;
    margin-bottom: 15px;
}

.features {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 24px 0 28px;
}

.features li {
    font-weight: 600;
    font-size: .91rem;
}

.features li::before {
    content: "✓ ";
    color: var(--green);
    font-weight: 800;
}

/* ================= TRAVEL GUIDE ================= */

.guide {
    background: white;
}

.guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.guide-card {
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--cream);
}

.guide-card h3 {
    font-size: 1.3rem;
    margin-bottom: 10px;
}

.guide-card p {
    color: var(--muted);
    font-size: .92rem;
}

/* ================= CALL TO ACTION ================= */

.cta {
    background: var(--dark);
    color: white;
    text-align: center;
    padding: 70px 0;
}

.cta h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 15px;
}

.cta p {
    max-width: 650px;
    margin: 0 auto 24px;
    color: #d9e8df;
}

.cta .eyebrow {
    color: #f3d28e;
}

/* ================= FOOTER ================= */

footer {
    background: #102e29;
    color: white;
    padding: 42px 0 20px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 30px;
}

.footer-grid p {
    color: #c2d0c8;
    font-size: .9rem;
    margin-top: 14px;
}

footer h3 {
    font-family: "DM Sans", sans-serif;
    margin-bottom: 14px;
    font-size: 1rem;
}

.footer-links {
    list-style: none;
}

.footer-links li {
    margin: 9px 0;
    color: #c2d0c8;
    font-size: .9rem;
}

.footer-links a:hover {
    color: #f3d28e;
}

.copyright {
    border-top: 1px solid #ffffff25;
    padding-top: 18px;
    text-align: center;
    color: #bdccc3;
    font-size: .82rem;
}

.footer-logo-image {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 50%;
    border: 2px solid #ffffff55;
    flex-shrink: 0;
}

/* ================= TABLETS ================= */

@media (max-width: 1100px) {
    .navbar {
        gap: 14px;
    }

    .logo {
        gap: 8px;
        font-size: .96rem;
    }

    .logo-image {
        width: 54px;
        height: 54px;
    }

    .nav-links {
        gap: 12px;
    }

    .nav-links a {
        font-size: .78rem;
    }
}

@media (max-width: 950px) {
    .places-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-grid {
        gap: 30px;
    }
}

/* ================= MOBILE NAVIGATION ================= */

@media (max-width: 850px) {
    .navbar {
        min-height: 78px;
    }

    .logo {
        font-size: 1rem;
        gap: 10px;
    }

    .logo-image {
        width: 48px;
        height: 48px;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 100%;
        left: -5.56%;
        right: -5.56%;
        width: 111.12%;
        padding: 14px 5%;
        background: transparent;
        border: none;
        box-shadow: none;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        white-space: normal;
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links li a {
        display: block;
        padding: 11px 0;
        font-size: .95rem;
        color: white;
        text-shadow: 0 1px 5px #00000080;
    }

    .nav-links .nav-cta {
        display: inline-block;
        text-align: center;
        margin-top: 8px;
        padding: 11px 15px;
        color: #202b23 !important;
        text-shadow: none;
    }
}

/* ================= SMALL SCREENS ================= */

@media (max-width: 760px) {
    section {
        padding: 60px 0;
    }

    .hero {
        min-height: 600px;
    }

    .hero-content {
        padding-top: 125px;
    }

    .facts-grid {
        grid-template-columns: 1fr;
    }

    .fact {
        justify-content: flex-start;
        border-right: 0;
        border-bottom: 1px solid var(--border);
        padding: 14px 5px;
    }

    .fact:last-child {
        border-bottom: 0;
    }

    .about-grid {
        grid-template-columns: 1fr;
    }

    .about-photo img {
        height: 330px;
    }

    .guide-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
        grid-column: 1 / -1;
    }
}

@media (max-width: 540px) {
    .container {
        width: 90%;
    }

    .logo {
        font-size: .9rem;
        gap: 8px;
    }

    .logo-image {
        width: 42px;
        height: 42px;
    }

    .hero h1 {
        font-size: 2.9rem;
    }

    .button {
        padding: 12px 14px;
        font-size: .9rem;
    }

    .button-outline {
        margin-left: 0;
        margin-top: 10px;
    }

    .places-grid,
    .guide-grid {
        grid-template-columns: 1fr;
    }

    .search {
        min-width: 100%;
        max-width: none;
    }

    .filters {
        gap: 6px;
    }

    .filter-btn {
        padding: 8px 10px;
        font-size: .82rem;
    }

    .features {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }

    .footer-brand {
        grid-column: auto;
    }
}
</style>
</head>

<body>

<!-- ================= HEADER ================= -->

<header>
    <div class="container navbar">

        <a class="logo" href="#home">
            <img
                src="logo.png"
                alt="Explore Chandigarh Logo"
                class="logo-image">
            <span>Explore Chandigarh</span>
        </a>

        <button
            class="menu-toggle"
            id="menuToggle"
            aria-label="Toggle navigation"
            aria-expanded="false">☰</button>

        <ul class="nav-links" id="navLinks">
            <li><a href="#home">Home</a></li>
            <li><a href="#destinations">Destinations</a></li>
            <li><a href="#about">About Chandigarh</a></li>
            <li><a href="#guide">Travel Guide</a></li>
            <li>
                <a class="nav-cta" href="#destinations">Explore Places ↗</a>
            </li>
        </ul>

    </div>
</header>

<main>

<!-- ================= HERO ================= -->

<section class="hero" id="home">
    <div class="container hero-content">
        <span class="eyebrow">Welcome to the City Beautiful</span>

        <h1>Discover the beauty of Chandigarh.</h1>

        <p>
            From the peaceful waters of Sukhna Lake to the artistic Rock Garden
            and iconic modern architecture, discover the places that make
            Chandigarh special.
        </p>

        <a href="#destinations" class="button button-gold">
            Explore Destinations →
        </a>

        <a href="#about" class="button button-outline">
            Discover the City
        </a>
    </div>
</section>

<!-- ================= HIGHLIGHTS ================= -->

<div class="facts">
    <div class="container facts-grid">

        <div class="fact">
            <span class="fact-icon" aria-hidden="true"></span>
            <div>
                <strong>The City Beautiful</strong>
                <small>Planned urban design</small>
            </div>
        </div>

        <div class="fact">
            <span class="fact-icon" aria-hidden="true"></span>
            <div>
                <strong>Green Chandigarh</strong>
                <small>Gardens, parks and lakes</small>
            </div>
        </div>

        <div class="fact">
            <span class="fact-icon" aria-hidden="true"></span>
            <div>
                <strong>Art &amp; Architecture</strong>
                <small>Culture and iconic landmarks</small>
            </div>
        </div>

    </div>
</div>

<!-- ================= DESTINATIONS ================= -->

<section id="destinations">
    <div class="container">

        <div class="section-heading">
            <span class="eyebrow">Explore Chandigarh</span>
            <h2>Places worth discovering.</h2>
            <p>
                Explore famous Chandigarh landmarks, peaceful gardens
                and distinctive architecture.
            </p>
        </div>

        <div class="tools">
            <div class="search">
                <input
                    id="searchInput"
                    type="search"
                    placeholder="Search Chandigarh places..."
                    aria-label="Search places">
            </div>

            <div class="filters">
                <button class="filter-btn active" data-filter="all">All Places</button>
                <button class="filter-btn" data-filter="nature">Nature</button>
                <button class="filter-btn" data-filter="culture">Culture</button>
                <button class="filter-btn" data-filter="architecture">Architecture</button>
            </div>
        </div>

        <div class="places-grid" id="placesGrid">

            <article class="place-card" data-category="nature">
                <div class="place-image">
                    <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Sukhna_Lake_Chandigarh_India.jpg"
                         alt="Sukhna Lake, Chandigarh" loading="lazy">
                    <span class="tag">Nature</span>
                </div>
                <div class="place-content">
                    <h3>Sukhna Lake</h3>
                    <p>A favourite city landmark for lakeside walks, boating, birdwatching and beautiful views of the Shivalik foothills.</p>
                    <div class="place-footer">
                        <span>Sector 1</span>
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Sukhna+Lake+Chandigarh" target="_blank" rel="noopener">View Map ↗</a>
                    </div>
                </div>
            </article>

            <article class="place-card" data-category="culture">
                <div class="place-image">
                    <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Rock_Garden_Memory_Stone,_Chandigarh,_India.jpg"
                         alt="Rock Garden, Chandigarh" loading="lazy">
                    <span class="tag">Art &amp; Culture</span>
                </div>
                <div class="place-content">
                    <h3>Rock Garden</h3>
                    <p>Explore a remarkable open-air art space featuring sculptures, mosaics and creative works made from recycled materials.</p>
                    <div class="place-footer">
                        <span>Sector 1</span>
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Rock+Garden+Chandigarh" target="_blank" rel="noopener">View Map ↗</a>
                    </div>
                </div>
            </article>

            <article class="place-card" data-category="nature">
                <div class="place-image">
                    <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Rose_Garden_Chandigarh.jpg"
                         alt="Rose Garden, Chandigarh" loading="lazy">
                    <span class="tag">Gardens</span>
                </div>
                <div class="place-content">
                    <h3>Zakir Hussain Rose Garden</h3>
                    <p>Enjoy landscaped lawns and seasonal floral displays at one of Chandigarh's best-known green spaces.</p>
                    <div class="place-footer">
                        <span>Sector 16</span>
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Zakir+Hussain+Rose+Garden+Chandigarh" target="_blank" rel="noopener">View Map ↗</a>
                    </div>
                </div>
            </article>

            <article class="place-card" data-category="architecture">
                <div class="place-image">
                    <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Palace_of_Assembly_Chandigarh.jpg"
                         alt="Palace of Assembly at Chandigarh Capitol Complex" loading="lazy">
                    <span class="tag">Architecture</span>
                </div>
                <div class="place-content">
                    <h3>Capitol Complex</h3>
                    <p>Discover Chandigarh's celebrated modernist architecture, designed around the vision of architect Le Corbusier.</p>
                    <div class="place-footer">
                        <span>Sector 1</span>
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Capitol+Complex+Chandigarh" target="_blank" rel="noopener">View Map ↗</a>
                    </div>
                </div>
            </article>

            <article class="place-card" data-category="architecture">
                <div class="place-image">
                    <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Gandhi_Bhawan,_Chandigarh.jpg"
                         alt="Gandhi Bhawan, Panjab University, Chandigarh" loading="lazy">
                    <span class="tag">City Landmark</span>
                </div>
                <div class="place-content">
                    <h3>Gandhi Bhawan</h3>
                    <p>Visit a distinctive landmark at Panjab University known for its striking architectural form and reflective setting.</p>
                    <div class="place-footer">
                        <span>Panjab University</span>
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Gandhi+Bhawan+Chandigarh" target="_blank" rel="noopener">View Map ↗</a>
                    </div>
                </div>
            </article>

            <article class="place-card" data-category="architecture">
                <div class="place-image">
                    <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Open_Hand_Monument.JPG"
                         alt="Open Hand Monument, Chandigarh" loading="lazy">
                    <span class="tag">Iconic Landmark</span>
                </div>
                <div class="place-content">
                    <h3>Open Hand Monument</h3>
                    <p>See Chandigarh's famous symbol of peace, unity and the idea of giving and receiving, located in the Capitol Complex.</p>
                    <div class="place-footer">
                        <span>Sector 1</span>
                        <a href="https://www.google.com/maps/search/?api=1&amp;query=Open+Hand+Monument+Chandigarh" target="_blank" rel="noopener">View Map ↗</a>
                    </div>
                </div>
